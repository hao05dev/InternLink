PORT=8001
# Rules work offline. Cloud providers must be enabled explicitly.
EXTRACTION_PROVIDER=rules
EMBEDDING_PROVIDER=disabled
GEMINI_API_KEY=
# Required only when the corresponding Gemini provider is enabled.
LLM_MODEL=
EMBEDDING_MODEL=
# Immutable provider/model release used in embedding cache keys.
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSION=768
PROVIDER_TIMEOUT_SECONDS=8
ENABLE_SAMPLE_BENCHMARK=false
CORS_ORIGINS=[]
# Set the same secret as AI_SERVICE_API_KEY in backend-core.
SERVICE_API_KEY=
# Optional: EMBEDDING_PROVIDER=local_e5, install requirements-local.txt first.
# Supply an existing local model directory and immutable revision; no download is automatic.
LOCAL_MODEL_PATH=
LOCAL_MODEL_REVISION=
