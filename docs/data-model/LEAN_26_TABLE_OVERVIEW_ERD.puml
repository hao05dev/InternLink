@startuml
title CTU InternLink - ERD tong quan 26 bang nghiep vu

hide methods
hide stereotypes
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam entity {
  BackgroundColor White
  BorderColor #35606F
}

legend left
  |= Ky hieu |= Y nghia |
  | PK | Khoa chinh |
  | FK | Khoa ngoai vat ly |
  | Net lien | Quan he co FK |
  | Ghi chu net dut | Quan he logical/JSONB/polymorphic |
endlegend

package "A. To chuc, tai khoan va ky thuc tap" #EAF4F4 {
  entity departments {
    * id : UUID <<PK>>
    --
    code : VARCHAR
    name : VARCHAR
  }

  entity academic_programs {
    * id : UUID <<PK>>
    --
    department_id : UUID <<FK>>
    code : VARCHAR
    name : VARCHAR
  }

  entity users {
    * id : UUID <<PK>>
    --
    department_id : UUID <<FK, nullable>>
    company_id : UUID <<FK, nullable>>
    email : VARCHAR
    role : VARCHAR
    is_active : BOOLEAN
  }

  entity internship_terms {
    * id : UUID <<PK>>
    --
    department_id : UUID <<FK>>
    code : VARCHAR
    semester : VARCHAR
    status : VARCHAR
  }

  entity student_rosters {
    * id : UUID <<PK>>
    --
    term_id : UUID <<FK>>
    program_id : UUID <<FK>>
    claimed_user_id : UUID <<FK, nullable>>
    student_code : VARCHAR
    eligibility_status : VARCHAR
  }

  entity student_profiles {
    * user_id : UUID <<PK, FK>>
    --
    program_id : UUID <<FK>>
    student_code : VARCHAR
    gpa : NUMERIC
  }
}

package "B. Doanh nghiep, tuyen dung va AI" #F7F2E8 {
  entity companies {
    * id : UUID <<PK>>
    --
    verified_by_user_id : UUID <<FK, nullable>>
    company_name : VARCHAR
    verification_status : VARCHAR
  }

  entity skill_taxonomies {
    * id : VARCHAR <<PK>>
    --
    skill_name : VARCHAR
    category : VARCHAR
    framework : VARCHAR
  }

  entity student_skills {
    * student_id : UUID <<PK, FK>>
    * skill_id : VARCHAR <<PK, FK>>
    --
    evidence_document_id : UUID <<FK, nullable>>
    source : VARCHAR
    is_confirmed : BOOLEAN
  }

  entity job_positions {
    * id : UUID <<PK>>
    --
    company_id : UUID <<FK>>
    term_id : UUID <<FK>>
    department_id : UUID <<FK>>
    approved_by_user_id : UUID <<FK, nullable>>
    title : VARCHAR
    status : VARCHAR
  }

  entity job_skills {
    * job_id : UUID <<PK, FK>>
    * skill_id : VARCHAR <<PK, FK>>
    --
    requirement_type : VARCHAR
    weight : NUMERIC
  }

  entity ai_runs {
    * id : UUID <<PK>>
    --
    student_id : UUID <<FK, nullable>>
    source_document_id : UUID <<FK, nullable>>
    job_id : UUID <<FK, nullable>>
    run_type : VARCHAR
    status : VARCHAR
  }

  entity job_applications {
    * id : UUID <<PK>>
    --
    job_id : UUID <<FK>>
    student_id : UUID <<FK>>
    submitted_cv_document_id : UUID <<FK>>
    matching_ai_run_id : UUID <<FK, nullable>>
    status : VARCHAR
  }

  entity placement_offers {
    * id : UUID <<PK>>
    --
    application_id : UUID <<FK, UNIQUE>>
    proposed_mentor_id : UUID <<FK, nullable>>
    status : VARCHAR
  }
}

package "C. Khoi tao va thuc hien thuc tap" #EEF1F8 {
  entity learning_agreements {
    * id : UUID <<PK>>
    --
    offer_id : UUID <<FK, UNIQUE>>
    student_id : UUID <<FK>>
    company_id : UUID <<FK>>
    department_id : UUID <<FK>>
    document_id : UUID <<FK, nullable>>
    status : VARCHAR
  }

  entity internship_placements {
    * id : UUID <<PK>>
    --
    agreement_id : UUID <<FK, UNIQUE>>
    student_id : UUID <<FK>>
    company_id : UUID <<FK>>
    mentor_id : UUID <<FK>>
    lecturer_id : UUID <<FK>>
    term_id : UUID <<FK>>
    status : VARCHAR
  }

  entity placement_tasks {
    * id : UUID <<PK>>
    --
    placement_id : UUID <<FK>>
    assigned_by_mentor_id : UUID <<FK>>
    title : VARCHAR
    status : VARCHAR
  }

  entity attendance_logs {
    * id : UUID <<PK>>
    --
    placement_id : UUID <<FK>>
    confirmed_by_user_id : UUID <<FK, nullable>>
    attendance_date : DATE
    status : VARCHAR
  }

  entity weekly_logbooks {
    * id : UUID <<PK>>
    --
    placement_id : UUID <<FK>>
    mentor_reviewed_by : UUID <<FK, nullable>>
    lecturer_commented_by : UUID <<FK, nullable>>
    week_number : INT
    status : VARCHAR
  }
}

package "D. Ngoai le, danh gia va ket qua" #F8EEEE {
  entity internship_cases {
    * id : UUID <<PK>>
    --
    placement_id : UUID <<FK>>
    reported_by_user_id : UUID <<FK>>
    assigned_to_user_id : UUID <<FK, nullable>>
    case_type : VARCHAR
    status : VARCHAR
  }

  entity rubric_evaluations {
    * id : UUID <<PK>>
    --
    placement_id : UUID <<FK>>
    evaluator_id : UUID <<FK>>
    evaluator_role : VARCHAR
    stage : VARCHAR
    status : VARCHAR
  }

  entity final_results {
    * id : UUID <<PK>>
    --
    placement_id : UUID <<FK, UNIQUE>>
    decided_by_user_id : UUID <<FK, nullable>>
    final_score : NUMERIC
    result : VARCHAR
  }
}

package "E. Tai lieu, thong bao va truy vet" #EDF6EC {
  entity documents {
    * id : UUID <<PK>>
    --
    owner_user_id : UUID <<FK>>
    context_type : VARCHAR
    context_id : UUID
    document_type : VARCHAR
    version_number : INT
    is_current : BOOLEAN
    status : VARCHAR
  }

  entity notifications {
    * id : UUID <<PK>>
    --
    recipient_user_id : UUID <<FK>>
    related_entity_type : VARCHAR
    related_entity_id : UUID
    read_at : TIMESTAMPTZ
  }

  entity state_history {
    * id : UUID <<PK>>
    --
    actor_user_id : UUID <<FK, nullable>>
    entity_type : VARCHAR
    entity_id : UUID
    from_state : VARCHAR
    to_state : VARCHAR
  }

  entity audit_logs {
    * id : UUID <<PK>>
    --
    actor_user_id : UUID <<FK, nullable>>
    entity_type : VARCHAR
    entity_id : UUID
    action : VARCHAR
  }
}

' Organization and identity
departments "1" -- "0..N" academic_programs : quan ly >
departments "0..1" -- "0..N" users : co thanh vien CTU >
companies "0..1" -- "0..N" users : co thanh vien DN >
users "0..1" -- "0..N" companies : tham dinh >
departments "1" -- "0..N" internship_terms : to chuc >
internship_terms "1" -- "0..N" student_rosters : bao gom >
academic_programs "1" -- "0..N" student_rosters : phan loai >
users "0..1" -- "0..N" student_rosters : claim >
users "1" -- "0..1" student_profiles : co ho so >
academic_programs "1" -- "0..N" student_profiles : dao tao >

' Skills, jobs and recruitment
users "1" -- "0..N" student_skills : so huu >
skill_taxonomies "1" -- "0..N" student_skills : chuan hoa >
documents "0..1" -- "0..N" student_skills : minh chung >
companies "1" -- "0..N" job_positions : dang tuyen >
internship_terms "1" -- "0..N" job_positions : ap dung >
departments "1" -- "0..N" job_positions : tham dinh >
users "0..1" -- "0..N" job_positions : phe duyet >
job_positions "1" -- "0..N" job_skills : yeu cau >
skill_taxonomies "1" -- "0..N" job_skills : duoc yeu cau >
users "0..1" -- "0..N" ai_runs : doi tuong SV >
documents "0..1" -- "0..N" ai_runs : nguon phan tich >
job_positions "0..1" -- "0..N" ai_runs : doi tuong job >
users "1" -- "0..N" job_applications : nop >
job_positions "1" -- "0..N" job_applications : nhan >
documents "1" -- "0..N" job_applications : CV snapshot >
ai_runs "0..1" -- "0..N" job_applications : matching snapshot >
job_applications "1" -- "0..1" placement_offers : phat sinh >
users "0..1" -- "0..N" placement_offers : mentor de xuat >

' Placement lifecycle
placement_offers "1" -- "0..1" learning_agreements : chuyen thanh >
users "1" -- "0..N" learning_agreements : SV tham gia >
companies "1" -- "0..N" learning_agreements : DN tham gia >
departments "1" -- "0..N" learning_agreements : phe duyet >
documents "0..1" -- "0..N" learning_agreements : ban ky >
learning_agreements "1" -- "0..1" internship_placements : kich hoat >
users "1" -- "0..N" internship_placements : sinh vien >
users "1" -- "0..N" internship_placements : mentor >
users "1" -- "0..N" internship_placements : GVHD >
companies "1" -- "0..N" internship_placements : tiep nhan >
internship_terms "1" -- "0..N" internship_placements : quan ly >
internship_placements "1" -- "0..N" placement_tasks : bao gom >
users "1" -- "0..N" placement_tasks : giao >
internship_placements "1" -- "0..N" attendance_logs : ghi nhan >
users "0..1" -- "0..N" attendance_logs : xac nhan >
internship_placements "1" -- "0..N" weekly_logbooks : co >
users "0..1" -- "0..N" weekly_logbooks : mentor review >
users "0..1" -- "0..N" weekly_logbooks : GVHD nhan xet >

' Cases and outcomes
internship_placements "1" -- "0..N" internship_cases : phat sinh >
users "1" -- "0..N" internship_cases : bao cao >
users "0..1" -- "0..N" internship_cases : xu ly >
internship_placements "1" -- "0..N" rubric_evaluations : duoc danh gia >
users "1" -- "0..N" rubric_evaluations : danh gia >
internship_placements "1" -- "0..1" final_results : co ket qua >
users "0..1" -- "0..N" final_results : quyet dinh >

' Cross-cutting physical owner/actor links
users "1" -- "0..N" documents : so huu >
users "1" -- "0..N" notifications : nhan >
users "0..1" -- "0..N" state_history : thuc hien >
users "0..1" -- "0..N" audit_logs : thuc hien >

note right of job_positions
  target_program_codes JSONB tao quan he logical M:N
  voi academic_programs; khong co FK vat ly trong ban lean.
end note

note bottom of documents
  documents, notifications, state_history va audit_logs
  lien ket logical den aggregate bang type + id.
  Khong keo day den tung bang tren ERD tong quan.
end note

@enduml
