# Database / web URL: use this file as a configuration checklist.
# Load environment variables through your IDE/launcher; Spring does not automatically load .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internlink_db
DB_USER=postgres
DB_PASSWORD=
APP_PUBLIC_URL=http://localhost:3000

# Existing files stay with their recorded provider. Only new uploads use STORAGE_PROVIDER.
STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=./uploads
# Set STORAGE_PROVIDER=R2 to enable new uploads after filling these values.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=internlink

# Delivery is disabled until sender credentials and database migration are ready.
EMAIL_ENABLED=
EMAIL_PROVIDER=DISABLED
EMAIL_FROM=
EMAIL_DELIVERY_MODE=
# REDIRECT gửi toàn bộ email test về một hộp thư và gắn người nhận gốc vào subject.
EMAIL_REDIRECT_TO=
# Chỉ dùng với EMAIL_DELIVERY_MODE=ALLOWLIST; phân tách bằng dấu phẩy.
EMAIL_ALLOWED_RECIPIENTS=
# HMAC SHA-256 secret (tối thiểu 32 ký tự khi LIVE) cho POST /api/v1/public/email-events.
EMAIL_EVENT_WEBHOOK_SECRET=
# Gmail personal: EMAIL_PROVIDER=GMAIL_SMTP, EMAIL_FROM equals GMAIL_SMTP_USERNAME.
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
# Workspace alternative: EMAIL_PROVIDER=GOOGLE_WORKSPACE.
# Requires an administrator-approved service account with domain-wide delegation for gmail.send.
GOOGLE_GMAIL_SENDER=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=

# Enable schedulers only after V18/V19 migrations and staging checks.
NOTIFICATION_REALTIME_ENABLED=true
NOTIFICATION_REMINDERS_ENABLED=false
NOTIFICATION_CAMPAIGNS_ENABLED=false
R2_DIRECT_UPLOAD_ENABLED=false
R2_PRESIGNED_SECONDS=300
R2_CLEANUP_ENABLED=false
UPLOAD_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Auth: provide a random secret of at least 32 characters before starting the backend.
JWT_SECRET=
JWT_EXPIRATION_MS=900000
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAINS=
# Comma-separated exact IP addresses of reverse proxies that sanitize X-Forwarded-For.
TRUSTED_PROXY_IPS=

# Redis: Caching, Distributed Rate Limiting & Concurrency Slot Control
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
